# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
JWT_SECRET="cv_builder_super_secure_jwt_secret_key_2026"

# DATABASE_URL: PostgreSQL database connection string (if using PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/cvbuilder?schema=public"
